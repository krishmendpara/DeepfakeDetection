PORT=5001

# Cloud MongoDB (MongoDB Atlas free tier recommended for cross-device access)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Local fallback (uncomment for offline/local development):
# MONGO_URI=mongodb://127.0.0.1:27017/ipdProject

JWT_SECRET=your_jwt_secret_key_here
ML_SERVICE_URL=http://localhost:8000/predict
CLIENT_URL=http://localhost:5173

# Cloudinary Cloud Storage (Step F3 - Recommended for global CDN and keeping Atlas database quota free)
# If left empty, the application automatically uses MongoDB Atlas GridFS
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
