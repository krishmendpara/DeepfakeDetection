{
  "name": "deepfake-detection-root",
  "version": "1.0.0",
  "description": "Deepfake Detection Fullstack Application",
  "scripts": {
    "start": "cd server && npm start",
    "dev": "cd server && npm run dev",
    "client": "cd frontend && npm start",
    "ml": "cd backend/ml_service && uvicorn main:app --host 0.0.0.0 --port 8000",
    "start-all": "concurrently \"npm run dev\" \"npm run client\" \"npm run ml\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
